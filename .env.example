# Everything here is optional. With none of it set the app runs on authored
# fixtures, a file store and an in-process queue — `npm run dev` and both eval
# suites work offline and deterministically.

# Live extraction and corroboration instead of authored fixtures.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Real embeddings instead of the local lexical embedder.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Postgres instead of the file store (schema in db/schema.sql).
# DATABASE_URL=postgres://provenance:provenance@localhost:5432/provenance

# Redis instead of the in-process queue.
# REDIS_URL=redis://localhost:6379

# Python ML service, for batch scoring and entity resolution.
# ML_SERVICE_URL=http://localhost:8000

# Usage metering. Without these, runs are metered to the audit log only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CUSTOMER_ID=cus_...
# STRIPE_METER_EVENT=assessment_run
